# Copy this file's content into: Streamlit Cloud → App settings → Secrets
# (or into a local .streamlit/secrets.toml for testing — never commit that real file to GitHub)

[sheet]
spreadsheet_id = "PASTE_THE_GOOGLE_SHEET_ID_HERE"
# the long id in the sheet's URL, between /d/ and /edit

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "navigator-app@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
